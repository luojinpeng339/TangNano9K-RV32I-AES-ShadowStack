// Tang Nano 9K Pin Constraints — FIXED 2026-07-17
// 来源: Sipeed 官方 CST
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP;

// UART — BL702 桥接 (pin 17=TXD, 18=RXD)
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// 注意: top_pipeline 的顶层没有 uart_rx 端口, 如需要请添加

